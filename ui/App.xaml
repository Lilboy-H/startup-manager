<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        mc:Ignorable="po"
        Title="自启动管家" Height="830" Width="1240" MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#161617"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <SolidColorBrush po:Freeze="False" x:Key="Bg"      Color="#161617"/>
    <SolidColorBrush po:Freeze="False" x:Key="Panel"   Color="#282829"/>
    <SolidColorBrush po:Freeze="False" x:Key="PanelHi" Color="#303031"/>
    <SolidColorBrush po:Freeze="False" x:Key="Card"    Color="#2D2E2E"/>
    <SolidColorBrush po:Freeze="False" x:Key="CardHi"  Color="#3A3B3B"/>
    <SolidColorBrush po:Freeze="False" x:Key="Stroke"  Color="#464647"/>
    <SolidColorBrush po:Freeze="False" x:Key="StrokeHi" Color="#5F6061"/>
    <SolidColorBrush po:Freeze="False" x:Key="Text"    Color="#EAF0FA"/>
    <SolidColorBrush po:Freeze="False" x:Key="Sub"     Color="#EAEBEB"/>
    <SolidColorBrush po:Freeze="False" x:Key="Dim"     Color="#AEAFB0"/>
    <SolidColorBrush po:Freeze="False" x:Key="Accent"  Color="#5B8DEF"/>
    <SolidColorBrush po:Freeze="False" x:Key="Accent2" Color="#8B5CF6"/>
    <SolidColorBrush po:Freeze="False" x:Key="Green"   Color="#35D399"/>
    <SolidColorBrush po:Freeze="False" x:Key="Amber"   Color="#F0B45B"/>
    <SolidColorBrush po:Freeze="False" x:Key="Red"     Color="#F0716E"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <LinearGradientBrush po:Freeze="False" x:Key="BrandGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#5B8DEF" Offset="0"/>
      <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush po:Freeze="False" x:Key="WindowBg" StartPoint="0,0" EndPoint="0.35,1">
      <GradientStop Color="#19191A" Offset="0"/>
      <GradientStop Color="#151515" Offset="1"/>
    </LinearGradientBrush>

    <!-- ================= 开关 ================= -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="25"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent" Width="46" Height="25">
              <Border x:Name="Track" CornerRadius="13" Background="#48494A" BorderBrush="#595A5B" BorderThickness="1"/>
              <Border x:Name="Knob" Width="17" Height="17" CornerRadius="9" Background="#D4D4D5"
                      HorizontalAlignment="Left" Margin="4,0,0,0">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" Color="#000000"/>
                </Border.Effect>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Green}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Green}"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                <Setter TargetName="Knob" Property="Background" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Knob" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.3"/>
                <Setter TargetName="Knob" Property="Opacity" Value="0.3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= 按钮 ================= -->
    <Style x:Key="GhostBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#D8E1F0"/>
      <Setter Property="Background" Value="#323233"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#575859"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHi}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeHi}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHi}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="17,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource BrandGrad}" CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= 列表项容器（含悬停高亮） ================= -->
    <Style x:Key="PlainItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= 深色复选框 ================= -->
    <Style x:Key="DarkCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="14" Height="14" CornerRadius="4" Background="{StaticResource Card}"
                      BorderBrush="#5F6061" BorderThickness="1" VerticalAlignment="Center">
                <Path x:Name="Tick" Data="M 2.5,7 L 5.5,10 L 11,3.5" Stroke="#FFFFFF" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#5B8DEF"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#5B8DEF"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="#CBD6E7"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#5B8DEF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= 导航项 ================= -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="Bd" CornerRadius="9" Background="Transparent" Padding="11,0" MinHeight="30"/>
              <Border x:Name="Bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                      Background="{StaticResource Accent}" Visibility="Collapsed" Margin="0,0,0,0"/>
              <ContentPresenter/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#323233"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#404142"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="NavTemplate">
      <Grid Margin="4,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="7" Height="7" CornerRadius="4" Background="{Binding Hex}"
                VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.85"/>
        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#CBD6E7" FontSize="12.5"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,7"/>
        <Border Grid.Column="2" Background="#39393A" CornerRadius="7" Padding="7,1" MinWidth="24"
                VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding HasCount, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{Binding Count}" Foreground="#DDDDDD" FontSize="10.5"
                     HorizontalAlignment="Center"/>
        </Border>
      </Grid>
    </DataTemplate>

    <!-- ================= 启动项卡片 ================= -->
    <DataTemplate x:Key="ItemTemplate">
      <Border x:Name="Card" Background="{StaticResource Card}" CornerRadius="11" Margin="0,0,0,8"
              BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Background="{Binding KindBrush}" CornerRadius="11,0,0,11" Opacity="0.9"/>

          <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10" Background="{Binding KindBg}"
                  Margin="14,13,13,13" VerticalAlignment="Center">
            <Grid>
              <TextBlock Text="{Binding Initial}" Foreground="{Binding KindBrush}" FontSize="16" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"/>
              <Image Source="{Binding IconPath}" Width="24" Height="24"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
          </Border>

          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,13,0,13">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="14"
                         FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="380"
                         VerticalAlignment="Center"/>
              <Border Background="{Binding KindBg}" CornerRadius="5" Padding="7,1.5" Margin="9,0,0,0"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="{Binding KindBrush}"
                           FontWeight="SemiBold"/>
              </Border>
              <Border Background="#3A2A2C" CornerRadius="5" Padding="7,1.5" Margin="6,0,0,0"
                      VerticalAlignment="Center" Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="需管理员" FontSize="10" Foreground="#F2A9A6"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding PathText}" Foreground="{StaticResource Sub}" FontSize="11"
                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="11"
                       Margin="0,0,11,0" VerticalAlignment="Center"/>
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=OneWay}"
                      IsEnabled="{Binding CanToggle}" Focusable="False"/>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHi}"/>
          <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource StrokeHi}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= 变更记录 ================= -->
    <DataTemplate x:Key="ChangeTemplate">
      <Border x:Name="Card" Background="{StaticResource Card}" CornerRadius="9" Margin="0,0,0,6"
              BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{Binding TypeBrush}" CornerRadius="9,0,0,9" Opacity="0.85"/>
          <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{StaticResource Dim}" FontSize="11"
                     VerticalAlignment="Center" Margin="14,10,12,10"/>
          <Border Grid.Column="2" Background="{Binding TypeBg}" CornerRadius="5" Padding="7,1.5" Margin="0,0,12,0"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="{Binding TypeBrush}" FontWeight="SemiBold"/>
          </Border>
          <TextBlock Grid.Column="3" Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="12.5"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="4" Text="{Binding Detail}" Foreground="{StaticResource Sub}" FontSize="11"
                     VerticalAlignment="Center" Margin="12,0,14,0"/>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- ================= 建议清单卡片 ================= -->
    <DataTemplate x:Key="AdviceTemplate">
      <Border x:Name="Card" Background="{StaticResource Card}" CornerRadius="11" Margin="0,0,0,8"
              BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Background="{Binding VerdictBrush}" CornerRadius="11,0,0,11" Opacity="0.9"/>

          <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10" Background="{Binding KindBg}"
                  Margin="14,13,13,13" VerticalAlignment="Top">
            <Grid>
              <TextBlock Text="{Binding Initial}" Foreground="{Binding KindBrush}" FontSize="16" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"/>
              <Image Source="{Binding IconPath}" Width="24" Height="24"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
          </Border>

          <StackPanel Grid.Column="2" Margin="0,13,0,13">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="14"
                         FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="330"
                         VerticalAlignment="Center"/>
              <Border Background="{Binding VerdictBg}" CornerRadius="5" Padding="8,1.5" Margin="9,0,0,0"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding VerdictLabel}" FontSize="10.5" Foreground="{Binding VerdictBrush}"
                           FontWeight="SemiBold"/>
              </Border>
              <Border Background="{Binding KindBg}" CornerRadius="5" Padding="7,1.5" Margin="6,0,0,0"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="{Binding KindBrush}" FontWeight="SemiBold"/>
              </Border>
              <Border Background="#3A2A2C" CornerRadius="5" Padding="7,1.5" Margin="6,0,0,0"
                      VerticalAlignment="Center" Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="需管理员" FontSize="10" Foreground="#F2A9A6"/>
              </Border>
            </StackPanel>

            <TextBlock Text="{Binding Purpose}" Foreground="{StaticResource Sub}" FontSize="11.5"
                       Margin="0,7,0,0" TextWrapping="Wrap" MaxWidth="580" HorizontalAlignment="Left"/>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBlock Text="{Binding ProsText}" Foreground="#5FCFA0" FontSize="11"
                         TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding ConsText}" Foreground="#CE8A82" FontSize="11" Margin="14,0,0,0"
                         TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="11"
                       Margin="0,0,11,0" VerticalAlignment="Center"/>
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=OneWay}"
                      IsEnabled="{Binding CanToggle}" Focusable="False"/>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHi}"/>
          <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource StrokeHi}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= 滚动条 ================= -->
    <Style x:Key="SlimScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="#707172" CornerRadius="3" Margin="2,0"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Style="{StaticResource SlimScrollThumb}"/>
                </Track.Thumb>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="8"/>
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.Thumb>
                      <Thumb Style="{StaticResource SlimScrollThumb}"/>
                    </Track.Thumb>
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Rectangle Grid.RowSpan="4" Fill="{StaticResource WindowBg}"/>
    <Ellipse Grid.RowSpan="4" Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top"
             Margin="0,-420,-260,0" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#1F3C7AFF" Offset="0"/>
          <GradientStop Color="#00000000" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse Grid.RowSpan="4" Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top"
             Margin="-240,-330,0,0" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#1A8F9091" Offset="0"/>
          <GradientStop Color="#00000000" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <!-- ================= 顶栏 ================= -->
    <Border Grid.Row="0" Padding="22,18,22,14" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource BrandGrad}">
            <TextBlock Text="启" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
            <TextBlock Text="自启动管家" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="SubTitle" Text="管理开机自启动 · 自动同步应用安装与卸载"
                       Foreground="{StaticResource Dim}" FontSize="11" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Background="{StaticResource PanelHi}" CornerRadius="10" BorderBrush="{StaticResource Stroke}"
                BorderThickness="1" Height="36" Width="330" Margin="26,0" VerticalAlignment="Center"
                HorizontalAlignment="Right">
          <Grid>
            <TextBlock x:Name="SearchHint" Text="搜索应用、命令或位置…" Foreground="{StaticResource Dim}"
                       FontSize="12" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                     CaretBrush="{StaticResource Text}" FontSize="12" Margin="11,0"
                     VerticalContentAlignment="Center" Focusable="True"/>
          </Grid>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="AdminBadge" Background="#12241C" CornerRadius="7" Padding="10,4" Margin="0,0,9,0"
                  BorderBrush="#1D3A2E" BorderThickness="1" VerticalAlignment="Center">
            <TextBlock x:Name="AdminText" Text="管理员" Foreground="{StaticResource Green}" FontSize="11"
                       FontWeight="SemiBold"/>
          </Border>
          <Button x:Name="ElevateBtn" Content="以管理员身份重启" Style="{StaticResource GhostBtn}" Margin="0,0,9,0"/>
          <Button x:Name="AdviceBtn" Content="一键扫描建议" Style="{StaticResource PrimaryBtn}" Margin="0,0,9,0"/>
          <Button x:Name="RefreshBtn" Content="重新扫描" Style="{StaticResource GhostBtn}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= 概览卡片 ================= -->
    <Grid Grid.Row="1" Margin="22,16,22,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelHi}" CornerRadius="12" BorderBrush="{StaticResource Stroke}"
              BorderThickness="1" Padding="15,13">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="9" Background="#3D3E3F" VerticalAlignment="Center">
            <TextBlock Text="Σ" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="全部启动项" Foreground="{StaticResource Dim}" FontSize="10.5"/>
            <TextBlock x:Name="StatTotal" Text="—" Foreground="{StaticResource Text}" FontSize="21"
                       FontWeight="Bold" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource PanelHi}" CornerRadius="12" BorderBrush="{StaticResource Stroke}"
              BorderThickness="1" Padding="15,13">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="9" Background="#132720" VerticalAlignment="Center">
            <TextBlock Text="●" Foreground="{StaticResource Green}" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="已启用" Foreground="{StaticResource Dim}" FontSize="10.5"/>
            <TextBlock x:Name="StatOn" Text="—" Foreground="{StaticResource Green}" FontSize="21"
                       FontWeight="Bold" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="4" Background="{StaticResource PanelHi}" CornerRadius="12" BorderBrush="{StaticResource Stroke}"
              BorderThickness="1" Padding="15,13">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="9" Background="#333434" VerticalAlignment="Center">
            <TextBlock Text="○" Foreground="#D5D6D6" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="已禁用" Foreground="{StaticResource Dim}" FontSize="10.5"/>
            <TextBlock x:Name="StatOff" Text="—" Foreground="{StaticResource Sub}" FontSize="21"
                       FontWeight="Bold" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="6" Background="{StaticResource PanelHi}" CornerRadius="12" BorderBrush="{StaticResource Stroke}"
              BorderThickness="1" Padding="15,13">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="9" Background="#2A2214" VerticalAlignment="Center">
            <TextBlock Text="!" Foreground="{StaticResource Amber}" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="建议优化" Foreground="{StaticResource Dim}" FontSize="10.5"/>
            <TextBlock x:Name="StatSugg" Text="—" Foreground="{StaticResource Amber}" FontSize="21"
                       FontWeight="Bold" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ================= 主体 ================= -->
    <Grid Grid.Row="2" Margin="22,10,22,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="12"
              BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="9,12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="分类" Foreground="{StaticResource Dim}" FontSize="10.5"
                     Margin="12,2,0,9" FontWeight="SemiBold"/>
          <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{StaticResource NavItem}"
                   ItemTemplate="{StaticResource NavTemplate}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </DockPanel>
      </Border>

      <Grid Grid.Column="2">
        <DockPanel>
          <TextBlock x:Name="ListHeader" DockPanel.Dock="Top" Foreground="{StaticResource Dim}" FontSize="11"
                     Margin="2,0,0,11"/>
          <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top" Text="没有匹配的启动项" Foreground="{StaticResource Dim}"
                     FontSize="12" Margin="4,20,0,0" Visibility="Collapsed"/>
          <ListBox x:Name="ItemsList" Background="Transparent" BorderThickness="0"
                   ItemTemplate="{StaticResource ItemTemplate}"
                   ItemContainerStyle="{StaticResource PlainItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.ScrollUnit="Pixel"/>
        </DockPanel>

        <DockPanel x:Name="ChangesPanel" Visibility="Collapsed">
          <TextBlock DockPanel.Dock="Top" x:Name="ChangesHeader" Text="最近变更" Foreground="{StaticResource Dim}"
                     FontSize="11" Margin="2,0,0,11"/>
          <ListBox x:Name="ChangesList" Background="Transparent" BorderThickness="0"
                   ItemTemplate="{StaticResource ChangeTemplate}"
                   ItemContainerStyle="{StaticResource PlainItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"/>
        </DockPanel>

        <DockPanel x:Name="AdvicePanel" Visibility="Collapsed">
          <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" CornerRadius="11" BorderBrush="{StaticResource Stroke}"
                  BorderThickness="1" Padding="9,8" Margin="0,0,0,11">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AdvFilterAll"  Content="全部"       Tag="all"       Style="{StaticResource GhostBtn}" Padding="11,5" Margin="0,0,7,0"/>
                <Button x:Name="AdvFilterRec"  Content="建议禁用"   Tag="recommend" Style="{StaticResource GhostBtn}" Padding="11,5" Margin="0,0,7,0"/>
                <Button x:Name="AdvFilterFree" Content="可以禁用"   Tag="free"      Style="{StaticResource GhostBtn}" Padding="11,5" Margin="0,0,7,0"/>
                <Button x:Name="AdvFilterCau"  Content="看你用不用" Tag="caution"   Style="{StaticResource GhostBtn}" Padding="11,5" Margin="0,0,7,0"/>
                <Button x:Name="AdvFilterKeep" Content="不建议禁用" Tag="keep"      Style="{StaticResource GhostBtn}" Padding="11,5"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="AdviceSummary" Text="" Foreground="{StaticResource Dim}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                <Button x:Name="AdviceScanBtn" Content="重新扫描" Style="{StaticResource GhostBtn}" Padding="12,5"/>
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock x:Name="AdviceHeader" DockPanel.Dock="Top" Foreground="{StaticResource Dim}" FontSize="11"
                     Margin="2,0,0,11" TextWrapping="Wrap"/>

          <Grid>
            <ListBox x:Name="AdviceList" Background="Transparent" BorderThickness="0"
                     ItemTemplate="{StaticResource AdviceTemplate}"
                     ItemContainerStyle="{StaticResource PlainItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel"/>
            <TextBlock x:Name="AdviceEmpty" Text="还没有扫描结果" Foreground="{StaticResource Dim}"
                       FontSize="12" Margin="4,20,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
          </Grid>
        </DockPanel>

        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="2,10,14,18">

            <TextBlock Text="外观" Foreground="{StaticResource Dim}" FontSize="10.5" FontWeight="SemiBold" Margin="2,0,0,9"/>
            <Border Background="{StaticResource Panel}" CornerRadius="12" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1" Padding="18,16" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="配色主题" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="点一下立即生效，不会重启，也不会改动任何启动项。" Foreground="{StaticResource Dim}"
                           FontSize="11" Margin="0,5,0,13"/>
                <UniformGrid Columns="4">
                  <Button x:Name="ThemeBtn0" Tag="纯黑" AutomationProperties.Name="主题-纯黑" Style="{StaticResource GhostBtn}" Padding="10,9" Margin="0,0,8,0"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel>
                      <Border Height="34" CornerRadius="7" Background="#0A0A0A" BorderBrush="#262626" BorderThickness="1"><Grid Margin="6,5"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="7"/></Grid.RowDefinitions><Border Grid.Row="0" CornerRadius="3" Background="#151515"/><Border Grid.Row="1" CornerRadius="3" Background="#5B8DEF" Margin="0,4,0,0"/></Grid></Border>
                      <TextBlock Text="纯黑" Foreground="{StaticResource Text}" FontSize="11.5" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="ThemeBtn1" Tag="石墨" AutomationProperties.Name="主题-石墨" Style="{StaticResource GhostBtn}" Padding="10,9" Margin="0,0,8,0"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel>
                      <Border Height="34" CornerRadius="7" Background="#161617" BorderBrush="#3A3B3B" BorderThickness="1"><Grid Margin="6,5"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="7"/></Grid.RowDefinitions><Border Grid.Row="0" CornerRadius="3" Background="#2D2E2E"/><Border Grid.Row="1" CornerRadius="3" Background="#5B8DEF" Margin="0,4,0,0"/></Grid></Border>
                      <TextBlock Text="石墨" Foreground="{StaticResource Text}" FontSize="11.5" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="ThemeBtn2" Tag="暖棕" AutomationProperties.Name="主题-暖棕" Style="{StaticResource GhostBtn}" Padding="10,9" Margin="0,0,8,0"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel>
                      <Border Height="34" CornerRadius="7" Background="#14100D" BorderBrush="#3A2F25" BorderThickness="1"><Grid Margin="6,5"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="7"/></Grid.RowDefinitions><Border Grid.Row="0" CornerRadius="3" Background="#2A1F17"/><Border Grid.Row="1" CornerRadius="3" Background="#5B8DEF" Margin="0,4,0,0"/></Grid></Border>
                      <TextBlock Text="暖棕" Foreground="{StaticResource Text}" FontSize="11.5" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="ThemeBtn3" Tag="原蓝" AutomationProperties.Name="主题-原蓝" Style="{StaticResource GhostBtn}" Padding="10,9"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel>
                      <Border Height="34" CornerRadius="7" Background="#0A0D13" BorderBrush="#222A39" BorderThickness="1"><Grid Margin="6,5"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="7"/></Grid.RowDefinitions><Border Grid.Row="0" CornerRadius="3" Background="#151B26"/><Border Grid.Row="1" CornerRadius="3" Background="#5B8DEF" Margin="0,4,0,0"/></Grid></Border>
                      <TextBlock Text="原蓝" Foreground="{StaticResource Text}" FontSize="11.5" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </UniformGrid>
              </StackPanel>
            </Border>

            <TextBlock Text="行为" Foreground="{StaticResource Dim}" FontSize="10.5" FontWeight="SemiBold" Margin="2,0,0,9"/>
            <Border Background="{StaticResource Panel}" CornerRadius="12" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1" Padding="18,16" Margin="0,0,0,14">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="自动同步间隔" Foreground="{StaticResource Text}" FontSize="12.5"/>
                    <TextBlock Text="每隔多少秒重新扫描一次，发现安装或卸载会自动更新列表。" Foreground="{StaticResource Dim}"
                               FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="WatchBtn0" Tag="3"  Content="3 秒"  Style="{StaticResource GhostBtn}" Padding="11,5" Margin="0,0,6,0"/>
                    <Button x:Name="WatchBtn1" Tag="5"  Content="5 秒"  Style="{StaticResource GhostBtn}" Padding="11,5" Margin="0,0,6,0"/>
                    <Button x:Name="WatchBtn2" Tag="10" Content="10 秒" Style="{StaticResource GhostBtn}" Padding="11,5" Margin="0,0,6,0"/>
                    <Button x:Name="WatchBtn3" Tag="30" Content="30 秒" Style="{StaticResource GhostBtn}" Padding="11,5"/>
                  </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource Stroke}" Margin="0,16,0,15"/>

                <CheckBox x:Name="SetSelfStartBox" Style="{StaticResource DarkCheck}"
                          Content="随 Windows 启动（开机自动运行本程序）" FontSize="12"/>
                <CheckBox x:Name="SetAutoDisableBox" Style="{StaticResource DarkCheck}" Margin="0,12,0,0"
                          Content="发现新增自启动项时自动禁用" FontSize="12"/>
                <CheckBox x:Name="SetShowSystemBox" Style="{StaticResource DarkCheck}" Margin="0,12,0,0"
                          Content="显示系统受保护项（默认隐藏，避免误关）" FontSize="12"/>
              </StackPanel>
            </Border>

            <TextBlock Text="忽略名单" Foreground="{StaticResource Dim}" FontSize="10.5" FontWeight="SemiBold" Margin="2,0,0,9"/>
            <Border Background="{StaticResource Panel}" CornerRadius="12" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1" Padding="18,16" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="每行一个名称，支持通配符，例如 Sm*。命中的启动项不扫描、也不自动禁用。"
                           Foreground="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBox x:Name="IgnoreBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                         Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                         Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}" FontSize="11.5"
                         Padding="9,7" VerticalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                  <Button x:Name="IgnoreSaveBtn" Content="保存忽略名单" Style="{StaticResource GhostBtn}" Padding="14,6"/>
                  <TextBlock x:Name="IgnoreHint" Text="" Foreground="{StaticResource Green}" FontSize="11"
                             VerticalAlignment="Center" Margin="11,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="数据与关于" Foreground="{StaticResource Dim}" FontSize="10.5" FontWeight="SemiBold" Margin="2,0,0,9"/>
            <Border Background="{StaticResource Panel}" CornerRadius="12" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1" Padding="18,16">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" Foreground="{StaticResource Dim}" FontSize="11.5" Margin="0,0,0,7"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AboutVersion" Text="-" Foreground="{StaticResource Sub}" FontSize="11.5" Margin="0,0,0,7"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="安装位置" Foreground="{StaticResource Dim}" FontSize="11.5" Margin="0,0,0,7"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AboutPath" Text="-" Foreground="{StaticResource Sub}" FontSize="11.5"
                             TextTrimming="CharacterEllipsis" Margin="0,0,0,7"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="数据目录" Foreground="{StaticResource Dim}" FontSize="11.5" Margin="0,0,0,7"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AboutData" Text="-" Foreground="{StaticResource Sub}" FontSize="11.5"
                             TextTrimming="CharacterEllipsis" Margin="0,0,0,7"/>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="运行状态" Foreground="{StaticResource Dim}" FontSize="11.5"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" x:Name="AboutState" Text="-" Foreground="{StaticResource Sub}" FontSize="11.5"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button x:Name="OpenDataBtn" Content="打开数据目录" Style="{StaticResource GhostBtn}" Padding="14,6" Margin="0,0,8,0"/>
                  <Button x:Name="OpenAppBtn" Content="打开安装目录" Style="{StaticResource GhostBtn}" Padding="14,6" Margin="0,0,8,0"/>
                  <Button x:Name="AboutDocBtn" Content="使用说明" Style="{StaticResource GhostBtn}" Padding="14,6"/>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- ================= 状态栏 ================= -->
    <Border Grid.Row="3" Padding="22,9" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0"
            Background="{StaticResource Panel}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" Text="准备就绪" Foreground="{StaticResource Sub}" FontSize="11"
                     Margin="9,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="SelfStartBox" Style="{StaticResource DarkCheck}" Content="随 Windows 启动"
                    FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <CheckBox x:Name="AutoDisableBox" Style="{StaticResource DarkCheck}" Content="新增自启动项自动禁用"
                    FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <Border Background="{StaticResource PanelHi}" CornerRadius="7" Padding="9,3" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
            <TextBlock x:Name="WatcherText" Text="" Foreground="{StaticResource Dim}" FontSize="10.5"
                       VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= 详情弹层 ================= -->
    <Grid x:Name="DetailOverlay" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed"
          Background="#D9111111">
      <Border x:Name="DetailCard" Width="840" MaxHeight="720" Background="{StaticResource Card}" CornerRadius="14"
              BorderBrush="{StaticResource StrokeHi}" BorderThickness="1" HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <DockPanel Margin="0">

          <Border DockPanel.Dock="Top" Padding="26,20,18,17" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1"
                  CornerRadius="14,14,0,0">
            <Border.Background>
              <LinearGradientBrush x:Name="DetailHeadBg" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#323233" Offset="0"/>
                <GradientStop Color="#222222" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="DetailTitle" Text="" Foreground="{StaticResource Text}"
                             FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Border x:Name="VerdictBadge" CornerRadius="6" Padding="9,3" Margin="11,1,0,0"
                          VerticalAlignment="Center" Background="#474748">
                    <TextBlock x:Name="VerdictText" Text="" Foreground="#F0B45B" FontSize="11" FontWeight="SemiBold"/>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="DetailSub" Text="" Foreground="{StaticResource Dim}" FontSize="11"
                           Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <Button Grid.Column="1" x:Name="DetailCloseBtn" Content="✕" Width="32" Height="32"
                      Style="{StaticResource GhostBtn}" Padding="0" Margin="14,0,0,0"
                      VerticalAlignment="Top" HorizontalAlignment="Right"/>
            </Grid>
          </Border>

          <Border DockPanel.Dock="Bottom" Padding="26,15,26,17" BorderBrush="{StaticResource Stroke}"
                  BorderThickness="0,1,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" x:Name="DetailHint" Text="" Foreground="{StaticResource Dim}"
                         FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="DetailOpenBtn" Content="打开位置" Style="{StaticResource GhostBtn}" Padding="13,5"/>
                <Button x:Name="DetailToggleBtn" Content="禁用此项" Style="{StaticResource GhostBtn}"
                        Margin="9,0,0,0" Padding="13,5"/>
              </StackPanel>
            </Grid>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Padding="26,18,22,22">
            <StackPanel>

              <TextBlock Text="这个程序是做什么的" Foreground="{StaticResource Dim}" FontSize="10.5"
                         FontWeight="SemiBold" Margin="0,0,0,8"/>
              <Border Background="{StaticResource Panel}" CornerRadius="9" Padding="15,13" BorderBrush="{StaticResource Stroke}"
                      BorderThickness="1" Margin="0,0,0,20">
                <TextBlock x:Name="PurposeText" Text="" Foreground="{StaticResource Sub}" FontSize="12.5"
                           TextWrapping="Wrap" LineHeight="22"/>
              </Border>

              <TextBlock Text="为什么这样建议" Foreground="{StaticResource Dim}" FontSize="10.5"
                         FontWeight="SemiBold" Margin="0,0,0,8"/>
              <Border Background="{StaticResource Panel}" CornerRadius="9" Padding="15,13" BorderBrush="{StaticResource Stroke}"
                      BorderThickness="1" Margin="0,0,0,20">
                <TextBlock x:Name="WhyText" Text="" Foreground="{StaticResource Sub}" FontSize="12.5"
                           TextWrapping="Wrap" LineHeight="22"/>
              </Border>

              <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1A1216" CornerRadius="9" Padding="15,13"
                        BorderBrush="#33202A" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="禁用之后" Foreground="#F2833B" FontSize="11.5" FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="DisText" Text="" Foreground="{StaticResource Sub}" FontSize="12"
                               TextWrapping="Wrap" LineHeight="21"/>
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#121A18" CornerRadius="9" Padding="15,13"
                        BorderBrush="#1E332C" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="保持启用" Foreground="#45C08C" FontSize="11.5" FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="KeepText" Text="" Foreground="{StaticResource Sub}" FontSize="12"
                               TextWrapping="Wrap" LineHeight="21"/>
                  </StackPanel>
                </Border>
              </Grid>

              <TextBlock Text="技术详情" Foreground="{StaticResource Dim}" FontSize="10.5"
                         FontWeight="SemiBold" Margin="0,0,0,8"/>
              <Border Background="{StaticResource Panel}" CornerRadius="9" Padding="15,11" BorderBrush="{StaticResource Stroke}"
                      BorderThickness="1">
                <StackPanel x:Name="FactsPanel"/>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
